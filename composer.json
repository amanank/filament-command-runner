{
    "name": "amanank/filament-command-runner",
    "description": "A reusable Composer package that provides a secure, extensible Filament UI for running predefined Artisan commands.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Amanank",
            "email": "info@amanank.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.28|^12.0",
        "filament/filament": "^4.0"
    },
    "require-dev": {
        "pestphp/pest": "^3.8",
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Amanank\\FilamentCommandRunner\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Amanank\\FilamentCommandRunner\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Amanank\\FilamentCommandRunner\\Providers\\FilamentCommandRunnerServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
